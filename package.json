{
  "name": "fd-digital-printing",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun ./node_modules/vite/bin/vite.js dev",
    "build": "bun ./node_modules/vite/bin/vite.js build",
    "preview": "bun ./node_modules/vite/bin/vite.js preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:seed": "bun src/lib/server/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:owner": "bun src/lib/server/db/seed-owner.ts",
    "reminder": "bun src/lib/server/jobs/reminder-piutang.ts"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "resend": "^6.32.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0"
  }
}
